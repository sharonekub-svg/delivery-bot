# ============================================================================
#  WEBSITE (the product)
#
#  Good news: the website needs NO required environment variables to run.
#  Your taste profile and your pasted 10Bis session are remembered in your
#  own browser; recommendations and ordering are plain code (no AI key).
# ============================================================================

# Optional: 10Bis client mode. Defaults to "local" (talks to the real 10Bis).
# Set to "mock" to demo the whole flow with fake data and no real account.
# TENBIS_CLIENT=local

# ============================================================================
#  LEGACY WhatsApp bot (optional) — only needed if you also run the original
#  Twilio/Supabase WhatsApp flow. The website does not require any of these.
# ============================================================================
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# CREDENTIALS_ENC_KEY=          # openssl rand -hex 32 (encrypts the WhatsApp session)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# ANTHROPIC_API_KEY=            # only the old WhatsApp blurbs used this
# ANTHROPIC_MODEL=claude-opus-4-8
# CRON_SECRET=
# APP_BASE_URL=http://localhost:3000
# APP_TIMEZONE=Asia/Jerusalem
