# ---- Supabase ----
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Encryption (AES-256-GCM). Generate: openssl rand -hex 32 ----
CREDENTIALS_ENC_KEY=

# ---- WhatsApp via Meta (Facebook) Cloud API ----
# From Meta App dashboard -> WhatsApp -> API Setup
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Any random string you choose; must match what you enter in the webhook config.
WHATSAPP_VERIFY_TOKEN=
# App secret (App Settings -> Basic) for verifying inbound webhook signatures.
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v21.0
# Approved template name for the proactive daily message (single {{1}} body param).
# Leave blank to send free-form text (only works within the 24h window).
WHATSAPP_DAILY_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=he

# ---- Anthropic (dish blurbs / NL) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# ---- 10Bis local API (YOU provide this) ----
TENBIS_API_BASE_URL=
# Set to "mock" to run without the real API, "local" to use the real 10Bis local API.
TENBIS_CLIENT=mock

# ---- App ----
APP_BASE_URL=http://localhost:3000
# Shared secret Vercel Cron sends in the Authorization header.
CRON_SECRET=
# Timezone used for daily triggers / working-day math.
APP_TIMEZONE=Asia/Jerusalem
