# ---- Supabase ----
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Encryption (AES-256-GCM). Generate: openssl rand -hex 32 ----
CREDENTIALS_ENC_KEY=

# ---- Twilio WhatsApp ----
# From console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# WhatsApp sender. Sandbox is whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ---- Anthropic (dish blurbs / NL) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# ---- 10Bis local API (YOU provide this) ----
TENBIS_API_BASE_URL=
# Set to "mock" to run without the real API, "local" to use the real 10Bis local API.
TENBIS_CLIENT=mock

# ---- App ----
APP_BASE_URL=http://localhost:3000
# Shared secret Vercel Cron sends in the Authorization header.
CRON_SECRET=
# Timezone used for daily triggers / working-day math.
APP_TIMEZONE=Asia/Jerusalem
