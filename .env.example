# ============================================================================
#  WEBSITE (the product) — these are what the web app needs.
# ============================================================================

# Encryption for the 10Bis session cookie (AES-256-GCM). Generate:
#   openssl rand -hex 32
CREDENTIALS_ENC_KEY=

# Anthropic — powers the chatbot. Required for the chat to work.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# 10Bis client: "local" hits the real 10Bis API (use this for real orders),
# "mock" runs the whole flow with deterministic fake data (no account needed).
TENBIS_CLIENT=local

# App base URL (used by the legacy WhatsApp links; harmless for the website).
APP_BASE_URL=http://localhost:3000
APP_TIMEZONE=Asia/Jerusalem

# ============================================================================
#  LEGACY WhatsApp bot (optional) — only needed if you run the Twilio/Supabase
#  WhatsApp flow. The website does not require any of these.
# ============================================================================
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
CRON_SECRET=
